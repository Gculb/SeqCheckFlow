process {
    container = "seqcheckflow-rnaseq:latest"
}

params.aws_queue = "seqcheckflow"
params.aws_region = "us-east-1"
params.aws_cli_path = "/home/ec2-user/miniconda/bin/aws"

profiles {
    docker {
        docker.enabled = true
    }

    awsbatch {
        process.executor = "awsbatch"
        process.queue = params.aws_queue
        process.memory = 8.GB
        docker.enabled = true
        aws.region = params.aws_region
        aws.batch.cliPath = params.aws_cli_path
    }
}
